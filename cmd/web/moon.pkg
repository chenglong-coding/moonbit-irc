import {
  "localreview/irc" @lib,
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "session_open",
        "session_open_auth",
        "session_receive",
        "session_status",
        "session_close",
        "validate_outgoing",
      ],
      "format": "esm",
    },
  },
)
